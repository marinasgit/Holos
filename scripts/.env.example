# Copy to .env and fill in from Supabase: Project Settings -> API.
# The service role key bypasses row level security. Keep it secret: never put it in the mobile app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides
# TCGDEX_BASE_URL=https://api.tcgdex.net/v2/en
# TCGDEX_CONCURRENCY=4
